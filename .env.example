# Copy to .env and fill in. Config is validated at boot: the process refuses to
# start and prints every problem at once rather than failing later at runtime.

NODE_ENV=development
LOG_LEVEL=info

# From @BotFather.
BOT_TOKEN=

# From https://my.telegram.org/apps. Streaming into a group call requires a user
# account, not a bot account — this is a Telegram protocol constraint.
TG_API_ID=
TG_API_HASH=

# Generate with `pnpm session`. This grants full access to the account. Never
# commit it, never paste it into a chat, rotate it if it leaks.
TG_SESSION=

DATABASE_URL=postgres://newera:newera@localhost:5432/newera
REDIS_URL=redis://localhost:6379

# Address the Go voice sidecar listens on.
VOICE_ADDR=127.0.0.1:50051

# Comma-separated numeric user ids with owner-level access.
OWNER_IDS=

# Optional channel for operational logs.
LOG_CHAT_ID=

# Optional. Both required together, or omit both to disable Spotify resolution.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Path to a yt-dlp cookies.txt. Required in practice for YouTube.
YTDLP_COOKIES=

AUTOLEAVE_SECONDS=60
MAX_QUEUE_LENGTH=200
MAX_TRACK_SECONDS=14400
