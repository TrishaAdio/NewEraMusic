# Copy to .env and fill in. .env is gitignored.
#
# The key is read from the environment only. Never pass it as a CLI flag (shell
# history) and never commit it (permanent in git history even after deletion).

# Any OpenAI-compatible endpoint. Include the version path.
#   https://api.openai.com/v1
#   https://openrouter.ai/api/v1
#   http://127.0.0.1:8787/v1            local mock, no real key needed
LLM_BASE_URL=http://127.0.0.1:8787/v1

LLM_API_KEY=

LLM_MODEL=mock-model

LLM_TEMPERATURE=0.2
# LLM_MAX_TOKENS=4096

# Abort if the stream goes silent for this long. Not a total timeout: long
# generations are fine, dead connections are not.
LLM_STALL_TIMEOUT_MS=60000

# Optional. Writes the largest fenced code block here when the stream finishes.
# LLM_OUT_FILE=out.ts
